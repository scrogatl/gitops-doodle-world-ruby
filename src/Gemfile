# Gemfile

source 'https://rubygems.org'

# Rackup not in Sinatra 4 so forcing earlier version
gem 'sinatra', '~> 3.0.6'
gem 'thin'
gem 'rackup'

# Agents are installed per flavor: the Dockerfile sets BUNDLE_WITHOUT so a
# plain image has neither group, newrelic has only :newrelic, otel only :otel.
group :newrelic do
  gem 'newrelic_rpm'
end

group :otel do
  gem 'opentelemetry-sdk', '~> 1.2.1'
  gem 'opentelemetry-exporter-otlp', '~> 0.25.0'
  gem 'opentelemetry-instrumentation-all', '~> 0.39.1'
end
